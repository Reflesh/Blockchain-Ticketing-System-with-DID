# 이 파일을 .env로 복사한 뒤 CHANGE_ME 값을 실제 값으로 변경한다.
# 실제 .env는 Git에 커밋하지 않는다.

# 실행 설정
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=false

# PostgreSQL/RDS 및 Polygon
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/CHANGE_ME
TICKET_PRIVATE_KEY=0xCHANGE_ME_64_HEX_CHARACTERS
CONTRACT_ADDRESS=0xCHANGE_ME

# 관리자 로그인 및 결제 연동 비밀값
ADMIN_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
ADMIN_TOKEN_TTL_SECONDS=7200
PORTONE_API_KEY=CHANGE_ME
PORTONE_API_SECRET=CHANGE_ME
PORTONE_V2_SECRET=CHANGE_ME

# Main → Auth 내부 연결
AUTH_VALIDATION_MODE=internal
AUTH_INTERNAL_BASE_URL=http://AUTH_SERVER_PRIVATE_IP:8001
# Auth 서버의 AUTH_SERVICE_KEY와 반드시 같은 값을 사용한다.
AUTH_SERVICE_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_ASCII_CHARACTERS
AUTH_HTTP_TIMEOUT_SECONDS=5
