# Copy to .env.auth (ignored). Never use real secrets in this example file.
ENV=development
DATABASE_URL=
RPC_URL=https://polygon-rpc.com
DID_CHAIN_ID=137
# Optional DID registry. Empty keeps on-chain DID registration disabled.
DID_CONTRACT_ADDRESS=
ISSUER_PRIVATE_KEY=
CI_SALT=
AUTH_SERVICE_KEY=
AUTH_INTERNAL_ONLY=true
SYNC_MAIN_USERS=true
DEV_EMAIL_AUTH_BYPASS=false
DOMAIN=localhost
SERVER_BASE_URL=http://localhost:8000
OID4VCI_ISSUER_BASE_URL=http://localhost:8000
AUTH_PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
GMAIL_ID=
GMAIL_APP_PASSWORD=
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_WORKERS=1
LOGIN_SESSION_TTL_SECONDS=3600
