# 이 파일을 .env로 복사한 뒤 CHANGE_ME 값을 실제 값으로 변경한다.
# 실제 .env는 Git에 커밋하지 않는다.

# 실행 설정
ENV=development
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_WORKERS=1
AUTH_RELOAD=false

# PostgreSQL/RDS
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME

# 절대 Git에 올리면 안 되는 비밀값
CI_SALT=CHANGE_ME_LONG_RANDOM_VALUE
ISSUER_PRIVATE_KEY=0xCHANGE_ME_64_HEX_CHARACTERS
AUTH_SERVICE_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_ASCII_CHARACTERS

# 이메일 인증. 개발 우회 사용 시에도 운영 계정의 비밀번호를 저장소에 넣지 않는다.
GMAIL_ID=issuer@example.com
GMAIL_APP_PASSWORD=CHANGE_ME
DEV_EMAIL_AUTH_BYPASS=false

# Wallet에서 접근하는 공개 주소와 웹 Origin
# 현재처럼 Main 서버가 Auth API를 중계하면 Main 서버의 공개 주소를 사용한다.
SERVER_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
OID4VCI_ISSUER_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
AUTH_PUBLIC_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
ALLOWED_ORIGINS=http://MAIN_SERVER_PUBLIC_IP:5173

# 모바일 Wallet이 Auth 서버에 직접 또는 Main 프록시를 통해 접근하는 현재 구조에서는 false
AUTH_INTERNAL_ONLY=false
SYNC_MAIN_USERS=false

# DID Registry를 사용하지 않을 때는 주소를 비워 둘 수 있다.
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/CHANGE_ME
DID_CHAIN_ID=80002
DID_CONTRACT_ADDRESS=
DOMAIN=MAIN_SERVER_PUBLIC_IP

# 세션 및 자격증명 유효시간(초)
LOGIN_SESSION_TTL_SECONDS=3600
OID4VCI_OFFER_TTL_SECONDS=300
OID4VCI_ACCESS_TOKEN_TTL_SECONDS=600
OID4VCI_NONCE_TTL_SECONDS=300
OID4VCI_PROOF_IAT_LEEWAY_SECONDS=300
MOBILE_PAIRING_TTL_SECONDS=120
MOBILE_CREDENTIAL_TTL_SECONDS=31536000
