# 기존 .env의 비밀값은 그대로 유지하고 Main 서버의 실행 설정만 덮어쓴다.
# 서버에서는 이 파일을 .env.backend.runtime으로 복사한다.
# 실제 runtime 파일은 Git에 커밋하지 않는다.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=false

# Main이 세션·VC 검증과 OpenID4VCI/모바일 연결 API를 Auth에 중계한다.
AUTH_VALIDATION_MODE=internal
AUTH_INTERNAL_BASE_URL=http://AUTH_SERVER_PRIVATE_IP:8001
AUTH_HTTP_TIMEOUT_SECONDS=5

# AUTH_SERVICE_KEY는 기존 .env에 있는 값을 사용하며 이 예시에 적지 않는다.
