# 기존 .env의 비밀값은 그대로 유지하면서 현재 시연 환경만 덮어쓸 때 사용한다.
# 서버에서는 이 파일을 .env.auth.runtime으로 복사한다.
# 실제 runtime 파일은 Git에 커밋하지 않는다.

ENV=development
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_WORKERS=1
AUTH_RELOAD=false

SERVER_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
OID4VCI_ISSUER_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
AUTH_PUBLIC_BASE_URL=http://MAIN_SERVER_PUBLIC_IP:8000
ALLOWED_ORIGINS=http://MAIN_SERVER_PUBLIC_IP:5173
SYNC_MAIN_USERS=false
DID_CONTRACT_ADDRESS=
