[Unit]
Description=TicketPro DID and OpenID4VCI Auth Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example Linux service account/path; create or replace them before installation.
User=ticketpro
Group=ticketpro
WorkingDirectory=/srv/ticketpro-auth
EnvironmentFile=/srv/ticketpro-auth/.env
# 기존 .env는 수정하지 않고, 선택적인 .env.auth.runtime을 run_server.py가 덮어쓴다.
ExecStart=/srv/ticketpro-auth/.venv/bin/python /srv/ticketpro-auth/run_server.py auth
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
