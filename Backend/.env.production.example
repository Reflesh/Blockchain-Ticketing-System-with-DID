# 실행 환경
ENV=production
AUTH_HOST=127.0.0.1
AUTH_PORT=8001
AUTH_WORKERS=1
AUTH_RELOAD=false
DATABASE_URL=postgresql://ticketpro:CHANGE_ME@db.internal:5432/ticketpro

# 반드시 기존 운영 값과 일치시켜야 하는 비밀값
CI_SALT=CHANGE_ME_LONG_RANDOM_VALUE
ISSUER_PRIVATE_KEY=0xCHANGE_ME_64_HEX_CHARACTERS
AUTH_SERVICE_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_ASCII_CHARACTERS
GMAIL_ID=issuer@example.com
GMAIL_APP_PASSWORD=CHANGE_ME

# 공개 HTTPS 주소. 같은 origin으로 운영하면 세 값을 동일하게 둔다.
SERVER_BASE_URL=https://auth.example.com
AUTH_PUBLIC_BASE_URL=https://auth.example.com
OID4VCI_ISSUER_BASE_URL=https://auth.example.com
DOMAIN=auth.example.com

# Auth 서버가 Wallet에 직접 공개되는 동안 false로 유지한다.
# Main 서버 reverse proxy 뒤에서 모든 요청을 전달할 때만 true로 바꾼다.
AUTH_INTERNAL_ONLY=false
SYNC_MAIN_USERS=true
ALLOWED_ORIGINS=https://app.example.com

# DID Registry / Polygon
RPC_URL=https://polygon-rpc.com
DID_CHAIN_ID=137
DID_CONTRACT_ADDRESS=0xCHANGE_ME

# 세션과 OpenID4VCI 유효시간(초)
LOGIN_SESSION_TTL_SECONDS=3600
OID4VCI_OFFER_TTL_SECONDS=300
OID4VCI_ACCESS_TOKEN_TTL_SECONDS=600
OID4VCI_NONCE_TTL_SECONDS=300
OID4VCI_PROOF_IAT_LEEWAY_SECONDS=300
MOBILE_PAIRING_TTL_SECONDS=120
MOBILE_CREDENTIAL_TTL_SECONDS=31536000

# 운영에서는 코드에 의해 무시되지만 명시적으로 꺼 둔다.
DEV_EMAIL_AUTH_BYPASS=false
